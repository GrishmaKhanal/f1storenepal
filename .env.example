# Local development. Copy to .env (git-ignored) and fill in:
#   cp .env.example .env
# Production values go in your host's settings instead; see .env.production.example
# and docs/deploy/env-vars.md. Never commit real values.

# ---- Database ----
# Local Postgres. Create it first: psql -h localhost -U postgres -c 'create database f1store'
# Leave empty to run on the read-only starter content.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/f1store
# Only needed when the provider has a separate direct URL (Neon). Empty locally.
DATABASE_URL_UNPOOLED=
# Leave empty locally (run `npm run db:migrate` yourself).
RUN_MIGRATIONS=

# ---- Admin ----
# Secret admin URL. Generate: echo "/pit-$(openssl rand -hex 4)". /admin itself always 404s.
# Empty disables the admin.
ADMIN_PATH=/pit-change-me
ADMIN_USERNAME=admin
# Anything you like locally; long and random in production.
ADMIN_PASSWORD=
# 32+ chars: openssl rand -base64 48
SESSION_SECRET=

# ---- Site ----
SITE_URL=http://localhost:3000

# ---- Images ----
# Leave S3_BUCKET empty: uploads go to ./.media and are served at /media/*.
# To test against a real bucket, use a separate dev bucket, never production's.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=

# ---- Google Maps (checkout location picker) ----
# Optional. Empty = customers paste a Google Maps link or share their location instead.
# A browser key. Enable "Maps JavaScript API" (the map), "Places API (New)" (search) and
# "Geocoding API" (jump to the chosen district), and restrict it to your site's
# addresses (HTTP referrers), e.g. http://localhost:3000/*
GOOGLE_MAPS_API_KEY=

# ---- Order emails (any SMTP server) ----
# Optional. With SMTP_HOST, SMTP_USER and SMTP_PASS set, customers who give an email
# get an "order received" confirmation, and each new order is emailed to ORDER_EMAIL_TO
# (when set; it's also where customers' replies go). Gmail: smtp.gmail.com, port 465,
# your Gmail address, and an App Password (Google Account → Security → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# The Gmail account that sends.
SMTP_USER=
# Its 16-character App Password, not the account password.
SMTP_PASS=
# Optional sender, e.g. "Lights Out Nepal <you@gmail.com>". Defaults to the store name + SMTP_USER.
SMTP_FROM=
# Comma-separated.
ORDER_EMAIL_TO=grishmakhanal48@gmail.com
ORDER_EMAIL_CC=
