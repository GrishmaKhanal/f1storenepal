# Production template (Vercel + Neon + Cloudflare R2). Don't fill this file in.
# Paste each key into Vercel → Project → Settings → Environment Variables
# (scope: Production, unless noted). Full reference: docs/deploy/env-vars.md
#
# Moving hosts? Same keys: any Postgres URL for DATABASE_URL, any S3-compatible
# bucket for S3_* and MEDIA_PUBLIC_URL. Nothing in the code is Vercel-specific.

# ---- Database (added automatically by Vercel's Neon integration) ----
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require
# Production only. Leave unset for Preview (previews share this database).
RUN_MIGRATIONS=true

# ---- Admin (secrets) ----
# echo "/pit-$(openssl rand -hex 4)"   (avoid /admin, /login, /dashboard)
ADMIN_PATH=/pit-xxxxxxxx
ADMIN_USERNAME=<owner-username>
# openssl rand -base64 24
ADMIN_PASSWORD=<long-random-password>
# openssl rand -base64 48  (rotating it logs everyone out)
SESSION_SECRET=<48-byte-random-string>

# ---- Site ----
# Your public domain, no trailing slash. Redeploy after changing it.
SITE_URL=https://f1storenepal.com

# ---- Images: Cloudflare R2 ----
# R2 → bucket → Settings: S3 API endpoint. Token: Object Read & Write, this bucket only.
S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=f1storenepal-media
S3_ACCESS_KEY_ID=<r2-access-key-id>
S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
# The bucket's public custom domain (R2 → bucket → Settings → Custom domains)
MEDIA_PUBLIC_URL=https://img.f1storenepal.com

# ---- AWS S3 + CloudFront instead of R2 ----
# S3_ENDPOINT=
# S3_REGION=ap-south-1
# S3_BUCKET=f1storenepal-media
# MEDIA_PUBLIC_URL=https://<distribution>.cloudfront.net
