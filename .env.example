# Copy to .env for local dev. On a host (Vercel: Project → Settings → Environment
# Variables), set the same keys. Never commit real values.

# ---- Database: any Postgres connection string ----
# Neon (*.neon.tech) uses Neon's serverless driver; anything else uses node-postgres.
DATABASE_URL=
# Optional direct (non-pooled) URL, used only by migrations.
DATABASE_URL_UNPOOLED=
# `true` makes `npm run build` apply pending migrations first. Production only.
RUN_MIGRATIONS=

# ---- Admin ----
# Secret admin URL, e.g. `/pit-$(openssl rand -hex 4)`. /admin itself always 404s.
# Leave empty to disable the admin.
ADMIN_PATH=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 32+ random chars: `openssl rand -base64 48`
SESSION_SECRET=

# Public origin (canonical URLs, sitemap, Open Graph, JSON-LD)
SITE_URL=http://localhost:3000

# ---- Image storage: any S3-compatible bucket (Cloudflare R2, AWS S3, B2, MinIO...) ----
# Leave S3_BUCKET empty in local dev: images are written to ./.media and served by the app.
# R2 example: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public CDN origin that serves the bucket, e.g. https://img.f1storenepal.com (no trailing slash)
MEDIA_PUBLIC_URL=
